# Server Environment Variables
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Anything already enabled here will run with safe defaults; everything else
# degrades gracefully (e-mail/SMS fall back to console logging, Razorpay
# payments accept demo orders).

# --- Core ---
PORT=5000
# See https://mongoosejs.com/docs/connections.html for MONGO_URI format.
MONGO_URI=mongodb://127.0.0.1:27017/hospital-db
# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=replace-with-a-secure-random-string
NODE_ENV=development
# Origin of the React client (used for CORS + any URL guards).
CLIENT_URL=http://localhost:5173

# --- Appointments ---
# Default Out-Patient Department consultation fee charged at booking.
OPD_FEE=300

# --- OTP delivery ---
# How long an OTP stays usable, in milliseconds (default 5 minutes).
OTP_TTL_MS=300000
# Optional SMS gateway used to deliver patient OTPs. When unset, OTPs are
# logged to the console instead of being sent.
SMS_GATEWAY_DOMAIN=

# --- E-mail (password resets, reports, notifications) ---
# When unset, e-mails are logged to the console instead of being sent.
# Nodemailer SMTP transport settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hospital Management <no-reply@example.com>
# Set to "true" to use TLS on the SMTP port (SMTPS).
SMTP_SECURE=false

# --- Razorpay (online payments) ---
# Create a test keypair at https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used to verify payment webhooks. Generate a random string and set the same
# value as the webhook secret configured in the Razorpay dashboard
# (Settings > Webhooks > Secret).
RAZORPAY_WEBHOOK_SECRET=