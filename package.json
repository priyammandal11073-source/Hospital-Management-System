{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital Management System - Full Stack Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "npm run start --prefix server",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "android:build": "npm run build:android --prefix client",
    "android:open": "npm run android:open --prefix client",
    "android:run": "npm run android:run --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  }
}
